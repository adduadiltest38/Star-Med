# Public production URL (no trailing slash). Used for canonical URLs, OG tags, sitemap and JSON-LD.
SITE_URL=https://www.your-clinic-domain.in

# Optional: form submission endpoint that accepts JSON POST (e.g. Formspree, Web3Forms, Getform,
# or your own serverless function). When empty, enquiries are handed over to WhatsApp instead.
PUBLIC_FORM_ENDPOINT=

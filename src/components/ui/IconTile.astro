---
import Icon from './Icon.astro';
import type { IconName } from '@/data/services';
interface Props { name: IconName; tone?: 'blue' | 'teal' | 'green'; size?: 'md' | 'lg'; class?: string }
const { name, tone = 'blue', size = 'md', class: className = '' } = Astro.props;
const tones = {
  blue: 'bg-brand-50 text-brand-600 ring-brand-100 group-hover:bg-brand-600 group-hover:text-white',
  teal: 'bg-teal-50 text-teal-600 ring-teal-100 group-hover:bg-teal-600 group-hover:text-white',
  green: 'bg-green-50 text-green-600 ring-green-100 group-hover:bg-green-600 group-hover:text-white',
};
---
<span
  class:list={[
    'inline-grid shrink-0 place-items-center rounded-2xl ring-1 transition-colors duration-500',
    size === 'lg' ? 'size-16' : 'size-14',
    tones[tone],
    className,
  ]}
>
  <Icon name={name} class={size === 'lg' ? 'size-8' : 'size-7'} />
</span>

---
/** Clearly marked notice for unconfirmed / placeholder information. */
import { Info } from 'lucide-react';
interface Props { tone?: 'info' | 'pending'; class?: string }
const { tone = 'pending', class: className = '' } = Astro.props;
---
<div
  class:list={[
    'flex items-start gap-3 rounded-2xl border px-4 py-3 text-sm leading-relaxed',
    tone === 'pending' ? 'border-amber-200 bg-amber-50 text-amber-900' : 'border-brand-100 bg-brand-50 text-brand-900',
    className,
  ]}
  role="note"
>
  <Info className="mt-0.5 size-4 shrink-0" aria-hidden="true" />
  <div><slot /></div>
</div>

---
import { Picture } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import Icon from './Icon.astro';
import type { Speciality } from '@/data/specialities';
interface Props { speciality: Speciality; headingLevel?: 'h2' | 'h3' }
const { speciality: s, headingLevel: H = 'h3' } = Astro.props;
const tone = { blue: 'bg-brand-600', teal: 'bg-teal-600', green: 'bg-green-600' }[s.tone];
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-[2rem] border border-line/70 bg-white shadow-soft transition-[transform,box-shadow] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:shadow-lift">
  <div class="relative aspect-[4/3] overflow-hidden">
    <Picture
      src={s.image}
      formats={['avif', 'webp']} fallbackFormat="webp"
      widths={[400, 600, 800]}
      sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
      alt={s.imageAlt}
      class="h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105"
    />
    <span class:list={['absolute top-4 left-4 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold text-white shadow-soft', tone]}>
      <Icon name={s.icon} class="size-3.5" strokeWidth={2.25} />
      {s.commonName}
    </span>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <H class="text-2xl font-bold">
      <a href={`/specialities#${s.slug}`} class="after:absolute after:inset-0 after:content-['']">{s.name}</a>
    </H>
    <p class="mt-2 flex-1 leading-relaxed text-ink-soft">{s.summary}</p>
    <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
      Learn more <ArrowUpRight className="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </div>
</article>

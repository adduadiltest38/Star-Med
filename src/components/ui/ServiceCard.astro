---
import { ArrowUpRight, Info } from 'lucide-react';
import IconTile from './IconTile.astro';
import { serviceHref, type Service } from '@/data/services';
interface Props { service: Service; headingLevel?: 'h2' | 'h3' }
const { service, headingLevel: H = 'h3' } = Astro.props;
const href = serviceHref(service);
const glow = { blue: 'from-brand-100', teal: 'from-teal-100', green: 'from-green-100' }[service.tone];
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-line/70 bg-white p-6 shadow-soft transition-[transform,box-shadow,border-color] duration-500 ease-[var(--ease-out-expo)] hover:-translate-y-1.5 hover:border-brand-100 hover:shadow-lift sm:p-7">
  <div aria-hidden="true" class:list={['pointer-events-none absolute -top-24 -right-24 size-56 rounded-full bg-gradient-to-br to-transparent opacity-0 blur-2xl transition-opacity duration-700 group-hover:opacity-100', glow]}></div>
  <IconTile name={service.icon} tone={service.tone} />
  <H class="mt-6 text-xl font-bold">
    <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{service.name}</a>
  </H>
  <p class="mt-2.5 flex-1 leading-relaxed text-ink-soft">{service.summary}</p>
  {
    service.availabilityNote && (
      <p class="mt-4 flex items-start gap-2 rounded-xl bg-amber-50 px-3 py-2 text-xs leading-relaxed text-amber-900">
        <Info className="mt-px size-3.5 shrink-0" aria-hidden="true" />
        {service.availabilityNote}
      </p>
    )
  }
  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700" aria-hidden="true">
    Learn more
    <ArrowUpRight className="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
  </span>
  <span aria-hidden="true" class="absolute inset-0 rounded-3xl ring-2 ring-transparent transition group-has-[a:focus-visible]:ring-brand-500"></span>
</article>

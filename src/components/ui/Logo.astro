---
/**
 * Star Med logo — recreated vector mark (rounded medical cross + star).
 * Replace with the clinic's official high-resolution logo when available:
 * drop the file into src/assets/brand/ and render it here instead.
 */
import { site } from '@/config/site';
interface Props {
  variant?: 'color' | 'light';
  class?: string;
  showWordmark?: boolean;
}
const { variant = 'color', class: className = '', showWordmark = true } = Astro.props;
const id = `lg-${Math.random().toString(36).slice(2, 8)}`;
const light = variant === 'light';
---
<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 48 48" class="size-10 shrink-0 sm:size-11" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2470E0" />
        <stop offset="1" stop-color="#13A3A3" />
      </linearGradient>
    </defs>
    <rect width="48" height="48" rx="14" fill={light ? '#ffffff' : `url(#${id})`} />
    <path
      d="M20.5 9h7a2 2 0 0 1 2 2v7.5H37a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7.5V37a2 2 0 0 1-2 2h-7a2 2 0 0 1-2-2v-7.5H11a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h7.5V11a2 2 0 0 1 2-2z"
      fill={light ? `url(#${id})` : '#ffffff'}
    />
    <path
      d="M24 17.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L24 27.4l-3.8 2 .7-4.3-3.1-3 4.3-.6z"
      fill={light ? '#ffffff' : '#22A365'}
    />
  </svg>
  {
    showWordmark && (
      <span class="flex flex-col leading-none">
        <span class:list={['font-display text-[1.2rem] font-extrabold tracking-tight sm:text-[1.3rem]', light ? 'text-white' : 'text-ink']}>
          Star <span class={light ? 'text-teal-200' : 'text-brand-600'}>Med</span>
        </span>
        <span class:list={['mt-1 text-[0.62rem] font-semibold tracking-[0.22em] uppercase', light ? 'text-white/70' : 'text-muted']}>
          Polyclinic
        </span>
        <span class="sr-only">{site.name}</span>
      </span>
    )
  }
</span>

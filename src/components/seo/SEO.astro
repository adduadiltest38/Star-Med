---
import { getImage } from 'astro:assets';
import { site } from '@/config/site';
import { pageTitle, normalizePath } from '@/lib/seo';
import ogDefault from '@/assets/images/og-default.png';
import type { ImageMetadata } from 'astro';

export interface SEOProps {
  title: string;
  description: string;
  /** Path override for canonical, defaults to current path. */
  canonicalPath?: string;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, canonicalPath, ogImage = ogDefault, ogImageAlt, ogType = 'website', noindex = false } =
  Astro.props as SEOProps;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const normalised = normalizePath(canonicalPath ?? Astro.url.pathname);
const canonical = new URL(normalised, siteUrl).toString();
const fullTitle = pageTitle(title);
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg', quality: 85, fit: 'cover' });
const ogUrl = new URL(og.src, siteUrl).toString();
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt ?? `${site.name} — ${site.tagline}`} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<meta name="geo.region" content={`${site.address.countryCode}-KL`} />
<meta name="geo.placename" content={`${site.address.city}, ${site.address.district}`} />
{site.geo && <meta name="geo.position" content={`${site.geo.latitude};${site.geo.longitude}`} />}

---
interface Props { data: unknown | unknown[] }
const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
// Escape "<" so the JSON cannot terminate the script element.
const json = (d: unknown) => JSON.stringify(d).replace(/</g, '\\u003c');
---
{items.map((d) => <script type="application/ld+json" set:html={json(d)} />)}

---
import { Picture } from 'astro:assets';
import { ArrowRight, HeartHandshake, Lightbulb, ShieldCheck, UsersRound } from 'lucide-react';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import clinicImg from '@/assets/images/clinic.png';
import { site } from '@/config/site';

const pillars = [
  { title: 'Our philosophy', body: 'Good healthcare should be close to home, easy to access and explained in plain language.', Icon: Lightbulb },
  { title: 'Patient-focused', body: 'We listen first. Your concerns, questions and comfort shape every visit.', Icon: UsersRound },
  { title: 'Quality & care', body: 'Careful assessment, clear guidance and respectful, attentive care at every step.', Icon: ShieldCheck },
];
---
<section class="section relative" aria-labelledby="about-title">
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class="relative order-2 lg:order-1">
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture
          src={clinicImg}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 40vw, 92vw"
          alt="Illustration of the Star Med Clinic building with a medical cross emblem and landscaped entrance"
          class="h-auto w-full"
        />
      </div>
      <div class="glass absolute -right-3 -bottom-8 max-w-[15rem] rounded-3xl p-5 sm:-right-8" data-reveal>
        <HeartHandshake className="size-7 text-teal-600" aria-hidden="true" />
        <p class="mt-3 font-display text-lg leading-snug font-bold text-ink">“{site.tagline}”</p>
      </div>
    </div>

    <div class="order-1 lg:order-2">
      <SectionHeading
        id="about-title"
        eyebrow="About Star Med"
        title="Accessible, patient-centred care"
        highlight="in Pallikkara"
      />
      <div class="prose-clinic mt-6" data-reveal>
        <p>
          <strong>{site.name}</strong> ({site.alternateName}) is a healthcare destination in Mouvval, Pallikkara, built around a simple idea:
          everyday and specialist medical services should be easy to reach and easy to understand.
        </p>
        <p>
          Consultation, a diagnostic laboratory, a pharmacy and ECG are available together, so patients and families can get what they need in a single visit.
        </p>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3" data-stagger>
        {
          pillars.map(({ title, body, Icon }) => (
            <li class="rounded-2xl border border-line/70 bg-surface p-5">
              <Icon className="size-6 text-brand-600" aria-hidden="true" />
              <h3 class="mt-3 text-base font-bold">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{body}</p>
            </li>
          ))
        }
      </ul>
      <a href="/about" class="mt-8 inline-flex items-center gap-2 font-semibold text-brand-700 hover:gap-3 transition-all" data-reveal>
        More about the clinic <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>

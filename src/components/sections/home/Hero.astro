---
import { Picture } from 'astro:assets';
import { ArrowRight, Phone, FlaskConical, Pill, Stethoscope, Activity, ShieldCheck } from 'lucide-react';
import Button from '@/components/ui/Button.astro';
import heroImg from '@/assets/images/hero-doctor.jpg';
import { site } from '@/config/site';

const headline = ['Your', 'Health.'];
const highlight = ['Our', 'Priority.'];
const chips = [
  { label: 'Consultation', Icon: Stethoscope },
  { label: 'Laboratory', Icon: FlaskConical },
  { label: 'Pharmacy', Icon: Pill },
  { label: 'ECG', Icon: Activity },
];
---
<section class="relative isolate overflow-hidden bg-mesh pt-28 pb-20 sm:pt-32 lg:pt-36 lg:pb-28" aria-labelledby="hero-title">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="bg-grid absolute inset-0"></div>
    <svg class="absolute top-[18%] left-[6%] hidden size-6 text-green-400 sm:block" data-float="12" viewBox="0 0 24 24"><path fill="currentColor" d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7z" /></svg>
    <svg class="absolute right-[44%] bottom-[12%] size-4 text-brand-300" data-float="8" viewBox="0 0 24 24"><path fill="currentColor" d="M9 2h6v7h7v6h-7v7H9v-7H2V9h7z" /></svg>
    <span class="absolute top-[30%] right-[4%] hidden size-3 rounded-full bg-teal-400 sm:block" data-float="10"></span>
  </div>

  <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="eyebrow" data-hero="1">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        {site.alternateName} · {site.address.city}
      </p>

      <h1 id="hero-title" class="h-display mt-6" data-hero="2" data-hero-split aria-label="Your Health. Our Priority.">
        {headline.map((w) => <><span class="split-word" aria-hidden="true"><span>{w}</span></span>{' '}</>)}
        <br class="hidden sm:block" />
        {highlight.map((w) => <><span class="split-word" aria-hidden="true"><span class="text-gradient">{w}</span></span>{' '}</>)}
      </h1>

      <p class="lead mt-6 max-w-xl" data-hero="3">
        Comprehensive healthcare services, trusted medical professionals and patient-focused care — all in one place.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-hero="4">
        <Button href="/services" size="lg">
          Explore Our Services <ArrowRight className="size-4 transition-transform group-hover/btn:translate-x-1" aria-hidden="true" />
        </Button>
        <Button href="/contact" variant="secondary" size="lg">
          <Phone className="size-4" aria-hidden="true" /> Contact the Clinic
        </Button>
      </div>

      <ul class="mt-10 flex flex-wrap gap-2.5" data-hero="5" aria-label="Available at the clinic">
        {
          chips.map(({ label, Icon }) => (
            <li class="inline-flex items-center gap-2 rounded-full border border-line/80 bg-white/70 px-3.5 py-2 text-sm font-medium text-ink-soft backdrop-blur">
              <Icon className="size-4 text-teal-600" aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md sm:max-w-lg lg:col-span-6 lg:max-w-none xl:pl-8">
      <div aria-hidden="true" class="absolute -top-6 -right-4 size-40 rounded-full bg-teal-100/80 sm:size-56"></div>
      <div aria-hidden="true" class="absolute top-1/3 -left-6 size-24 rounded-full bg-brand-100 sm:size-32"></div>
      <div class="relative mx-auto w-[86%] sm:w-[80%]" data-hero="2" data-hero-image>
        <div class="relative overflow-hidden rounded-t-[999px] rounded-b-[2.5rem] bg-gradient-to-b from-brand-500 to-teal-500 p-2 shadow-lift">
          <div class="overflow-hidden rounded-t-[999px] rounded-b-[2rem] bg-surface-2">
            <Picture
              src={heroImg}
              formats={['avif', 'webp']} fallbackFormat="webp"
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1280px) 460px, (min-width: 1024px) 38vw, (min-width: 640px) 410px, 78vw"
              alt="Doctor in a white coat with a stethoscope, standing with arms folded and smiling confidently"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] h-auto w-full object-cover"
            />
          </div>
        </div>
      </div>

      <!-- Floating glass cards -->
      <div class="glass absolute top-[38%] -left-1 flex items-center gap-3 rounded-2xl p-3 pr-4 sm:top-[30%] sm:-left-4 sm:p-4" data-hero="6" aria-hidden="true">
        <div data-float="8" class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-xl bg-teal-50 text-teal-600 sm:size-11"><FlaskConical className="size-5" /></span>
          <span class="text-left">
            <span class="block text-sm font-bold text-ink">Lab &amp; Pharmacy</span>
            <span class="block text-xs text-muted">Under one roof</span>
          </span>
        </div>
      </div>

      <div class="glass absolute -right-1 bottom-[22%] hidden w-44 rounded-2xl p-3 sm:-right-2 sm:block sm:w-52 sm:p-4" data-hero="7" aria-hidden="true">
        <div data-float="10">
          <div class="flex items-center justify-between text-xs font-semibold text-ink">
            <span class="inline-flex items-center gap-1.5"><Activity className="size-4 text-brand-600" /> ECG</span>
            <span class="relative inline-flex size-2.5">
              <span class="absolute inset-0 animate-pulse-ring rounded-full bg-green-400"></span>
              <span class="relative size-2.5 rounded-full bg-green-500"></span>
            </span>
          </div>
          <svg viewBox="0 0 200 50" class="mt-2 h-10 w-full" fill="none">
            <path class="ecg-line" d="M0 30h56l8-14 10 28 12-40 10 34 8-8h96" stroke="#1659C4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="mt-1 block text-[0.7rem] text-muted">Heart activity assessment</span>
        </div>
      </div>

      <div class="glass absolute -bottom-6 left-6 flex items-center gap-2.5 rounded-full py-2.5 pr-5 pl-2.5 sm:left-10" data-hero="8" aria-hidden="true">
        <span class="grid size-9 place-items-center rounded-full bg-green-500 text-white"><ShieldCheck className="size-5" /></span>
        <span class="text-sm font-semibold text-ink">{site.tagline}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .ecg-line {
    stroke-dasharray: 260;
    stroke-dashoffset: 260;
    animation: ecg 3.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes ecg {
    0% { stroke-dashoffset: 260; }
    55% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -260; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ecg-line { stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
  }
</style>

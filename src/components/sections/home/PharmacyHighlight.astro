---
import { Picture } from 'astro:assets';
import { ArrowRight, PackageSearch, FileText, MessageCircle } from 'lucide-react';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import pharmacyImg from '@/assets/images/pharmacy.jpg';
import { whatsappHref } from '@/lib/contact';
const wa = whatsappHref('Hello Star Med Pharmacy, I would like to check medicine availability.');
const points = [
  { title: 'Medication availability', body: 'Check whether a medicine is in stock before you travel.', Icon: PackageSearch },
  { title: 'Prescription enquiries', body: 'Questions about your prescription? Our pharmacy team is here to help.', Icon: FileText },
];
---
<section class="section relative bg-gradient-to-b from-white to-surface" aria-labelledby="pharmacy-title">
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div class="relative order-2 lg:order-1">
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture
          src={pharmacyImg}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          alt="Well-organised pharmacy interior with neatly stocked medicine shelves"
          class="h-auto w-full"
        />
      </div>
    </div>
    <div class="order-1 lg:order-2">
      <SectionHeading
        id="pharmacy-title"
        eyebrow="Pharmacy"
        title="Your medicines,"
        highlight="right after your visit"
        intro="The Star Med pharmacy is located within the clinic, so you can collect prescribed medicines before you head home."
      />
      <ul class="mt-8 space-y-4" data-stagger>
        {
          points.map(({ title, body, Icon }) => (
            <li class="flex gap-4 rounded-2xl border border-line/70 bg-white p-5 shadow-soft">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-green-50 text-green-600"><Icon className="size-6" aria-hidden="true" /></span>
              <span>
                <span class="block font-bold text-ink">{title}</span>
                <span class="mt-1 block text-ink-soft">{body}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
        <Button href="/pharmacy">About the pharmacy <ArrowRight className="size-4" aria-hidden="true" /></Button>
        {wa ? (
          <Button href={wa} variant="whatsapp" external><MessageCircle className="size-4" aria-hidden="true" /> Ask on WhatsApp</Button>
        ) : (
          <Button href="/contact?service=pharmacy#enquiry" variant="secondary"><MessageCircle className="size-4" aria-hidden="true" /> Contact the pharmacy</Button>
        )}
      </div>
    </div>
  </div>
</section>

---
import { MapPin, Navigation, Clock, Phone, ExternalLink } from 'lucide-react';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import { addressLines, directionsHref, mapEmbedSrc, mapViewHref, telHref, formatTime } from '@/lib/contact';
interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
---
<section id="location" class="section relative" aria-labelledby="location-title">
  <div class="container-x">
    <SectionHeading id="location-title" as={headingLevel} eyebrow="Find us" title="Visit Star Med" highlight="in Pallikkara" />
    <div class="mt-12 grid gap-6 lg:grid-cols-5">
      <div class="card flex flex-col p-7 sm:p-9 lg:col-span-2" data-reveal>
        <span class="grid size-14 place-items-center rounded-2xl bg-brand-600 text-white shadow-glow"><MapPin className="size-7" aria-hidden="true" /></span>
        <address class="mt-6 not-italic">
          <span class="block text-sm font-semibold tracking-wider text-teal-700 uppercase">{site.name}</span>
          <span class="mt-2 block font-display text-2xl leading-snug font-bold text-ink sm:text-[1.7rem]">
            {addressLines[0]}<br />{addressLines[1]}
          </span>
          <span class="mt-2 block text-ink-soft">{site.address.district}, {site.address.region}</span>
        </address>
        <dl class="mt-7 space-y-4 border-t border-line pt-6 text-sm">
          <div class="flex gap-3">
            <dt><Clock className="size-5 text-teal-600" aria-hidden="true" /><span class="sr-only">Opening hours</span></dt>
            <dd class="text-ink-soft">
              {site.openingHours.length > 0
                ? site.openingHours.map((h) => <span class="block">{h.days.map((d) => d.slice(0, 3)).join(', ')}: {formatTime(h.opens)} – {formatTime(h.closes)}</span>)
                : <span>Opening hours to be confirmed — please call or message the clinic.</span>}
            </dd>
          </div>
          <div class="flex gap-3">
            <dt><Phone className="size-5 text-teal-600" aria-hidden="true" /><span class="sr-only">Phone</span></dt>
            <dd class="text-ink-soft">
              {telHref ? <a class="font-semibold text-brand-700 hover:underline" href={telHref}>{site.contact.phoneDisplay ?? site.contact.phone}</a> : <span>Phone number to be updated by the clinic.</span>}
            </dd>
          </div>
        </dl>
        <div class="mt-auto flex flex-col gap-3 pt-8 sm:flex-row lg:flex-col xl:flex-row">
          <Button href={directionsHref} external class="flex-1"><Navigation className="size-4" aria-hidden="true" /> Get Directions</Button>
          <Button href={mapViewHref} variant="secondary" external class="flex-1"><ExternalLink className="size-4" aria-hidden="true" /> Open in Maps</Button>
        </div>
      </div>
      <div class="relative min-h-[22rem] overflow-hidden rounded-3xl border border-line/70 bg-surface-2 shadow-card lg:col-span-3" data-reveal>
        <div aria-hidden="true" class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_center,var(--color-brand-100)_0,transparent_60%)]">
          <div class="bg-grid absolute inset-0"></div>
          <span class="relative grid size-16 place-items-center rounded-full bg-brand-600 text-white shadow-glow">
            <span class="absolute inset-0 animate-pulse-ring rounded-full bg-brand-400"></span>
            <MapPin className="relative size-7" />
          </span>
        </div>
        <iframe
          title={`Map showing the location of ${site.name}, ${addressLines.join(' ')}`}
          src={mapEmbedSrc}
          class="absolute inset-0 h-full w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

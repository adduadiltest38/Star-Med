---
import { Picture } from 'astro:assets';
import { ArrowRight, CheckCircle2, MessageCircle } from 'lucide-react';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import labImg from '@/assets/images/laboratory.png';
import { labCatalogue } from '@/data/laboratory';
import { whatsappHref } from '@/lib/contact';
const sample = labCatalogue.categories.slice(0, 4);
const wa = whatsappHref('Hello Star Med, I have a question about a laboratory test.');
---
<section class="section relative overflow-hidden" aria-labelledby="lab-title">
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-40 size-[36rem] -translate-y-1/2 rounded-full bg-teal-100/60 blur-3xl"></div>
  <div class="container-x relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div>
      <SectionHeading
        id="lab-title"
        eyebrow="Diagnostic laboratory"
        title="Tests done right here,"
        highlight="with care"
        intro="Our in-house laboratory supports your doctor with routine diagnostic testing — no need to travel elsewhere for common tests."
      />
      <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-stagger>
        {
          sample.map((c) => (
            <li class="flex items-start gap-3 rounded-2xl border border-line/70 bg-white p-4 shadow-soft">
              <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-teal-600" aria-hidden="true" />
              <span>
                <span class="block font-semibold text-ink">{c.name}</span>
                <span class="mt-0.5 block text-sm text-muted">{c.tests.slice(0, 2).join(', ')}…</span>
              </span>
            </li>
          ))
        }
      </ul>
      {!labCatalogue.confirmed && <p class="mt-3 text-xs text-muted" data-reveal>Example test categories — please confirm availability with the clinic.</p>}
      <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
        <Button href="/laboratory">Explore the laboratory <ArrowRight className="size-4" aria-hidden="true" /></Button>
        {wa ? (
          <Button href={wa} variant="secondary" external><MessageCircle className="size-4" aria-hidden="true" /> Test enquiry</Button>
        ) : (
          <Button href="/contact?service=laboratory#enquiry" variant="secondary"><MessageCircle className="size-4" aria-hidden="true" /> Test enquiry</Button>
        )}
      </div>
    </div>
    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture
          src={labImg}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 1024px) 45vw, 92vw"
          alt="Illustration of laboratory equipment — a microscope, test tubes, a flask and a test report"
          class="h-auto w-full"
        />
      </div>
    </div>
  </div>
</section>

---
import { Picture } from 'astro:assets';
import { ArrowRight, FileText, MessageCircle, PackageSearch, Phone, Pill, ShieldCheck } from 'lucide-react';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CTABand from '@/components/sections/home/CTABand.astro';
import pharmacyImg from '@/assets/images/pharmacy.jpg';
import { getService } from '@/data/services';
import { serviceSchema } from '@/lib/seo';
import { telHref, whatsappHref } from '@/lib/contact';

const service = getService('pharmacy');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const wa = whatsappHref('Hello Star Med Pharmacy, I would like to check if a medicine is available.');
const enquiryHref = '/contact?service=pharmacy&type=general#enquiry';
const features = [
  { title: 'Prescriptions after your visit', body: 'Collect medicines prescribed during your consultation before you leave the clinic.', Icon: Pill },
  { title: 'Medication availability', body: 'Not sure if a medicine is in stock? Ask us before you travel.', Icon: PackageSearch },
  { title: 'Prescription enquiries', body: 'Questions about your prescription can be directed to our pharmacy team.', Icon: FileText },
  { title: 'Safe dispensing', body: 'Prescription medicines are dispensed against a valid prescription, as required by law.', Icon: ShieldCheck },
];
---
<PageLayout
  title={service?.seoTitle ?? 'Pharmacy'}
  description={service?.seoDescription ?? ''}
  heading="Pharmacy"
  highlight="at Star Med"
  eyebrow="Pharmacy services"
  intro="An on-site pharmacy within the clinic, so you can collect your medicines right after your consultation."
  breadcrumbs={[{ name: 'Services', href: '/services' }, { name: 'Pharmacy', href: '/pharmacy' }]}
  schema={[serviceSchema(siteUrl, { name: 'Pharmacy', description: service?.description ?? '', url: new URL('/pharmacy', siteUrl).toString() })]}
  pageType="MedicalWebPage"
>
  <section class="section pt-10" aria-labelledby="ph-intro">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture src={pharmacyImg} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 45vw, 92vw" alt="Well-organised pharmacy interior with neatly stocked medicine shelves" class="h-auto w-full" loading="eager" />
      </div>
      <div>
        <h2 id="ph-intro" class="h-section" data-split>Convenient, reliable pharmacy care</h2>
        <div class="prose-clinic mt-6" data-reveal><p>{service?.description}</p></div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
          {wa ? <Button href={wa} variant="whatsapp" external><MessageCircle className="size-4" aria-hidden="true" /> Check availability</Button> : <Button href={enquiryHref}><MessageCircle className="size-4" aria-hidden="true" /> Check availability</Button>}
          {telHref ? <Button href={telHref} variant="secondary"><Phone className="size-4" aria-hidden="true" /> Call the pharmacy</Button> : <Button href="/contact" variant="secondary">Contact us <ArrowRight className="size-4" aria-hidden="true" /></Button>}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="ph-features">
    <div class="container-x">
      <SectionHeading id="ph-features" align="center" eyebrow="How we help" title="Pharmacy" highlight="services" />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {features.map(({ title, body, Icon }) => (
          <li class="card p-7">
            <span class="grid size-12 place-items-center rounded-2xl bg-green-50 text-green-600"><Icon className="size-6" aria-hidden="true" /></span>
            <h3 class="mt-5 text-lg font-bold">{title}</h3>
            <p class="mt-2 leading-relaxed text-ink-soft">{body}</p>
          </li>
        ))}
      </ul>
      <p class="mx-auto mt-10 max-w-2xl text-center text-sm text-muted" data-reveal>
        Please consult a doctor or pharmacist before starting, stopping or changing any medication.
      </p>
    </div>
  </section>
  <CTABand title="Need to check a medicine?" text="Message or call our pharmacy team before you visit — we’ll let you know what’s available." />
</PageLayout>

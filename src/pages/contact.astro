---
import { Mail, MapPin, Navigation, Phone, Clock, Siren } from 'lucide-react';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import SocialIcon from '@/components/ui/SocialIcon.astro';
import LocationSection from '@/components/sections/home/LocationSection.astro';
import EnquiryForm from '@/islands/EnquiryForm';
import { site } from '@/config/site';
import { services } from '@/data/services';
import {
  addressLines, directionsHref, telHref, mailHref, whatsappHref, defaultWhatsAppMessage, formatTime,
} from '@/lib/contact';

const wa = whatsappHref(defaultWhatsAppMessage);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || undefined;
const pending = 'To be updated by the clinic';

const cards = [
  {
    title: 'Call us',
    value: site.contact.phoneDisplay ?? site.contact.phone ?? pending,
    href: telHref,
    cta: 'Call now',
    Icon: Phone,
    tone: 'bg-brand-50 text-brand-600',
  },
  {
    title: 'WhatsApp',
    value: wa ? 'Chat with the clinic' : pending,
    href: wa,
    cta: 'Open WhatsApp',
    external: true,
    tone: 'bg-green-50 text-[#128C4B]',
    whatsapp: true,
  },
  {
    title: 'Email',
    value: site.contact.email ?? pending,
    href: mailHref,
    cta: 'Send email',
    Icon: Mail,
    tone: 'bg-teal-50 text-teal-600',
  },
  {
    title: 'Visit',
    value: `${addressLines[0]} ${addressLines[1]}`,
    href: directionsHref,
    cta: 'Get directions',
    external: true,
    Icon: MapPin,
    tone: 'bg-brand-50 text-brand-600',
  },
];
---
<PageLayout
  title="Contact Star Med Clinic, Pallikkara — Appointments & Enquiries"
  description="Contact Star Med Clinic, opposite Hanafi Masjid, Mouvval, Pallikkara 671316. Request an appointment, ask about lab tests or medicines, or get directions."
  heading="Contact"
  highlight="the clinic"
  eyebrow="We’re here to help"
  intro="Request an appointment, ask a question about our services or find your way to us. We’ll get back to you as soon as possible."
  breadcrumbs={[{ name: 'Contact Us', href: '/contact' }]}
  pageType="ContactPage"
>
  <section class="pb-8" aria-labelledby="contact-options">
    <div class="container-x">
      <h2 id="contact-options" class="sr-only">Ways to contact us</h2>
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          cards.map((c) => (
            <li class="card flex flex-col p-6">
              <span class:list={['grid size-12 place-items-center rounded-2xl', c.tone]}>
                {c.whatsapp ? <SocialIcon name="whatsapp" class="size-6" /> : c.Icon && <c.Icon className="size-6" aria-hidden="true" />}
              </span>
              <h3 class="mt-5 text-lg font-bold">{c.title}</h3>
              <p class:list={['mt-1 flex-1 text-sm leading-relaxed', c.href ? 'text-ink-soft' : 'text-muted italic']}>{c.value}</p>
              {c.href ? (
                <a
                  href={c.href}
                  class="mt-5 inline-flex h-11 items-center justify-center rounded-full bg-surface px-4 text-sm font-semibold text-brand-700 transition hover:bg-brand-600 hover:text-white"
                  {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  {c.cta}{c.external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              ) : (
                <span class="mt-5 inline-flex h-11 items-center justify-center rounded-full border border-dashed border-line px-4 text-xs text-muted">Not yet available</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="enquiry" class="section scroll-mt-20 pt-16" aria-labelledby="enquiry-title">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <p class="eyebrow" data-reveal><span class="eyebrow-dot" aria-hidden="true"></span>Enquiry form</p>
        <h2 id="enquiry-title" class="h-section mt-5" data-split>Request an appointment</h2>
        <p class="lead mt-5" data-reveal>
          Tell us what you need and when you’d prefer to come in. The clinic will contact you to confirm.
        </p>
        <ul class="mt-8 space-y-4 text-sm text-ink-soft" data-stagger>
          <li class="flex gap-3"><Clock className="size-5 shrink-0 text-teal-600" aria-hidden="true" />
            <span>{site.openingHours.length > 0 ? site.openingHours.map((h) => `${h.days.map((d) => d.slice(0, 3)).join(', ')}: ${formatTime(h.opens)} – ${formatTime(h.closes)}`).join(' · ') : 'Opening hours to be confirmed by the clinic.'}</span>
          </li>
          <li class="flex gap-3 rounded-2xl border border-red-100 bg-red-50 p-4 text-red-900">
            <Siren className="size-5 shrink-0" aria-hidden="true" />
            <span><strong>Medical emergency?</strong> Don’t use this form. Call <a href="tel:112" class="font-semibold underline">112</a> or go to the nearest emergency department.</span>
          </li>
        </ul>
      </div>
      <div class="lg:col-span-8">
        <div class="card p-5 sm:p-8 lg:p-10" data-reveal>
          <EnquiryForm
            client:visible
            services={services.map((s) => ({ slug: s.slug, name: s.name }))}
            clinicName={site.name}
            endpoint={endpoint}
            whatsapp={site.contact.whatsapp}
            email={site.contact.email}
            phoneHref={telHref}
          />
        </div>
      </div>
    </div>
  </section>

  <LocationSection />

  <section class="pb-24" aria-label="Directions">
    <div class="container-x">
      <div class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-surface p-7 sm:flex-row sm:items-center sm:p-9" data-reveal>
        <div>
          <p class="font-display text-xl font-bold">Finding us is easy</p>
          <p class="mt-1 text-ink-soft">Look for {site.name} opposite Hanafi Masjid in Mouvval, Pallikkara.</p>
        </div>
        <Button href={directionsHref} external><Navigation className="size-4" aria-hidden="true" /> Start navigation</Button>
      </div>
    </div>
  </section>
</PageLayout>

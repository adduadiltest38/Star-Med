---
import { Picture } from 'astro:assets';
import { HeartHandshake, Lightbulb, ShieldCheck, UsersRound, Building2, ArrowRight } from 'lucide-react';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import CTABand from '@/components/sections/home/CTABand.astro';
import clinicImg from '@/assets/images/clinic.png';
import { site } from '@/config/site';
import { services, serviceHref } from '@/data/services';
import { whyChoose } from '@/data/why-choose';

const values = [
  { title: 'Accessible', body: 'Care that is close to home and straightforward to reach, with clear information about what we offer.', Icon: Building2 },
  { title: 'Patient-centred', body: 'We listen carefully and take time to explain, so you can make informed decisions about your health.', Icon: UsersRound },
  { title: 'Thoughtful', body: 'Assessment first, then the right next step — whether that is treatment, a test or a specialist opinion.', Icon: Lightbulb },
  { title: 'Respectful', body: 'Every patient is treated with dignity, privacy and kindness — at every age and every stage.', Icon: HeartHandshake },
];
---
<PageLayout
  title="About Us — Star Med Clinic, Pallikkara"
  description="Learn about Star Med Clinic (Star Med Polyclinic) in Mouvval, Pallikkara — a patient-focused healthcare destination offering consultation, laboratory, pharmacy and specialist care."
  heading="Committed to your health,"
  highlight="Always"
  eyebrow="About Star Med"
  intro={`${site.name} is a polyclinic in Pallikkara focused on accessible, patient-centred medical services for families across the area.`}
  breadcrumbs={[{ name: 'About Us', href: '/about' }]}
  pageType="AboutPage"
>
  <section class="section pt-12" aria-labelledby="story-title">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture src={clinicImg} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 45vw, 92vw" alt="Illustration of the Star Med Clinic building" class="h-auto w-full" loading="eager" />
      </div>
      <div>
        <SectionHeading id="story-title" eyebrow="Who we are" title="A healthcare destination" highlight="for our community" />
        <div class="prose-clinic mt-6" data-reveal>
          <p>
            Located opposite Hanafi Masjid in Mouvval, Pallikkara, <strong>{site.name}</strong> — also known as <strong>{site.alternateName}</strong> — brings together the services people most often need: doctor consultation, specialist care, a diagnostic laboratory, a pharmacy and ECG.
          </p>
          <p>
            Our aim is simple. When you or someone in your family is unwell, getting good care should not mean travelling between several places. Having consultation, tests and medicines in one building saves time and makes it easier to follow your doctor’s advice.
          </p>
          <p>
            We believe in clear communication: explaining what we find, what we recommend and why — so you always know the next step.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="values-title">
    <div class="container-x">
      <SectionHeading id="values-title" align="center" eyebrow="Our approach" title="How we" highlight="care for you" intro="The principles that guide every consultation, test and conversation at Star Med." />
      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {
          values.map(({ title, body, Icon: I }) => (
            <li class="card p-7">
              <span class="grid size-12 place-items-center rounded-2xl bg-brand-50 text-brand-600"><I className="size-6" aria-hidden="true" /></span>
              <h3 class="mt-5 text-xl font-bold">{title}</h3>
              <p class="mt-2 leading-relaxed text-ink-soft">{body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="offer-title">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading id="offer-title" eyebrow="What we offer" title="Everything in" highlight="one place" intro="A connected set of services designed around how patients actually move through care." />
        <div class="mt-8" data-reveal><Button href="/services">View all services <ArrowRight className="size-4" aria-hidden="true" /></Button></div>
      </div>
      <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-7" data-stagger="0.05">
        {
          services.map((s) => (
            <li>
              <a href={serviceHref(s)} class="group flex items-center gap-4 rounded-2xl border border-line/70 bg-white p-4 shadow-soft transition hover:-translate-y-0.5 hover:border-brand-100 hover:shadow-card">
                <span class="grid size-11 place-items-center rounded-xl bg-surface text-brand-600 transition-colors group-hover:bg-brand-600 group-hover:text-white"><Icon name={s.icon} class="size-5" /></span>
                <span class="font-semibold text-ink">{s.name}</span>
                <ArrowRight className="ml-auto size-4 text-brand-300 transition-transform group-hover:translate-x-1 group-hover:text-brand-600" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bg-surface pt-20" aria-labelledby="why-about-title">
    <div class="container-x">
      <SectionHeading id="why-about-title" eyebrow="Why patients choose us" title="Convenience, clarity" highlight="and care" />
      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-stagger>
        {
          whyChoose.map((w) => (
            <li class="flex gap-4 rounded-3xl bg-white p-6 shadow-soft">
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-teal-50 text-teal-600"><Icon name={w.icon} class="size-6" /></span>
              <span><h3 class="text-lg font-bold">{w.title}</h3><p class="mt-1.5 leading-relaxed text-ink-soft">{w.body}</p></span>
            </li>
          ))
        }
        <li class="flex gap-4 rounded-3xl bg-gradient-to-br from-brand-600 to-teal-600 p-6 text-white shadow-soft">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-white/15"><ShieldCheck className="size-6" aria-hidden="true" /></span>
          <span><h3 class="text-lg font-bold text-white">Honest information</h3><p class="mt-1.5 leading-relaxed text-white/85">We only share details we can stand behind. If something needs confirming, we’ll tell you.</p></span>
        </li>
      </ul>
    </div>
  </section>

  <CTABand />
</PageLayout>

---
import { Picture } from 'astro:assets';
import { ArrowRight, ClipboardCheck, FlaskConical, MessageCircle, Microscope, Phone } from 'lucide-react';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import Notice from '@/components/ui/Notice.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CTABand from '@/components/sections/home/CTABand.astro';
import LabTestFinder from '@/islands/LabTestFinder';
import labImg from '@/assets/images/laboratory.png';
import { labCatalogue, labVisitTips } from '@/data/laboratory';
import { getService } from '@/data/services';
import { serviceSchema } from '@/lib/seo';
import { telHref, whatsappHref } from '@/lib/contact';

const service = getService('laboratory');
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const wa = whatsappHref('Hello Star Med Laboratory, I have a question about a test.');
const enquiryHref = '/contact?service=laboratory&type=general#enquiry';
---
<PageLayout
  title={service?.seoTitle ?? 'Laboratory'}
  description={service?.seoDescription ?? ''}
  heading="Diagnostic"
  highlight="laboratory"
  eyebrow="Laboratory services"
  intro="Routine diagnostic testing right inside the clinic — so tests advised by your doctor can be done without another trip."
  breadcrumbs={[{ name: 'Services', href: '/services' }, { name: 'Laboratory', href: '/laboratory' }]}
  schema={[serviceSchema(siteUrl, { name: 'Diagnostic laboratory', description: service?.description ?? '', url: new URL('/laboratory', siteUrl).toString() })]}
  pageType="MedicalWebPage"
>
  <section class="section pt-10" aria-labelledby="lab-intro">
    <div class="container-x grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 id="lab-intro" class="h-section" data-split>Testing that’s part of your care</h2>
        <div class="prose-clinic mt-6" data-reveal>
          <p>{service?.description}</p>
          <p>Our laboratory team can help with questions about tests, sample collection and what to bring on the day.</p>
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-3" data-stagger>
          <li class="rounded-2xl bg-surface p-4"><FlaskConical className="size-6 text-teal-600" aria-hidden="true" /><p class="mt-2 font-semibold">Diagnostic testing</p></li>
          <li class="rounded-2xl bg-surface p-4"><Microscope className="size-6 text-teal-600" aria-hidden="true" /><p class="mt-2 font-semibold">In-house lab</p></li>
          <li class="rounded-2xl bg-surface p-4"><ClipboardCheck className="size-6 text-teal-600" aria-hidden="true" /><p class="mt-2 font-semibold">Test enquiries</p></li>
        </ul>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal>
          {wa ? <Button href={wa} variant="whatsapp" external><MessageCircle className="size-4" aria-hidden="true" /> Ask about a test</Button> : <Button href={enquiryHref}><MessageCircle className="size-4" aria-hidden="true" /> Ask about a test</Button>}
          {telHref && <Button href={telHref} variant="secondary"><Phone className="size-4" aria-hidden="true" /> Call the lab</Button>}
        </div>
      </div>
      <div class="overflow-hidden rounded-[2rem] shadow-lift" data-img-reveal>
        <Picture src={labImg} formats={['avif', 'webp']} fallbackFormat="webp" widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 45vw, 92vw" alt="Illustration of a diagnostic laboratory with a microscope, test tubes and a report" class="h-auto w-full" loading="eager" />
      </div>
    </div>
  </section>

  <section id="tests" class="section bg-surface" aria-labelledby="tests-title">
    <div class="container-x">
      <SectionHeading id="tests-title" eyebrow="Test catalogue" title="Available" highlight="tests" intro="Search or filter common laboratory tests. Not sure if we offer a test? Just ask." />
      {!labCatalogue.confirmed && (
        <Notice class="mt-6 max-w-3xl">
          This list shows example test categories and is pending confirmation by the clinic. Please contact the laboratory to confirm availability, preparation and report timelines.
        </Notice>
      )}
      <div class="mt-10">
        <LabTestFinder client:visible categories={labCatalogue.categories} enquiryHref={enquiryHref} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tips-title">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading id="tips-title" eyebrow="Before your visit" title="Preparing for" highlight="a test" />
      </div>
      <ol class="grid gap-4 lg:col-span-7" data-stagger>
        {labVisitTips.map((t, i) => (
          <li class="flex items-start gap-4 rounded-2xl border border-line/70 bg-white p-5 shadow-soft">
            <span class="grid size-10 shrink-0 place-items-center rounded-full bg-teal-600 font-display font-bold text-white">{i + 1}</span>
            <span class="pt-1.5 text-ink-soft">{t}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="container-x mt-10" data-reveal>
      <a href="/services" class="inline-flex items-center gap-2 font-semibold text-brand-700 hover:underline">Explore all services <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </section>
  <CTABand title="Questions about a test?" text="Our laboratory team is happy to help with test availability and preparation." />
</PageLayout>

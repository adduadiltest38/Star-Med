---
import type { GetStaticPaths } from 'astro';
import { ArrowRight, CheckCircle2, MessageCircle, Phone } from 'lucide-react';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import Notice from '@/components/ui/Notice.astro';
import IconTile from '@/components/ui/IconTile.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import CTABand from '@/components/sections/home/CTABand.astro';
import { services, type Service } from '@/data/services';
import { serviceSchema } from '@/lib/seo';
import { telHref, whatsappHref } from '@/lib/contact';
import { site } from '@/config/site';

export const getStaticPaths = (() =>
  services
    // Services with their own dedicated page (Laboratory, Pharmacy) are not duplicated here.
    .filter((s) => !s.featuredPage)
    .map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

interface Props { service: Service }
const { service } = Astro.props;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(`/services/${service.slug}`, siteUrl).toString();
const wa = whatsappHref(`Hello ${site.name}, I would like to enquire about ${service.name}.`);
const related = services.filter((s) => s.slug !== service.slug).slice(0, 3);
---
<PageLayout
  title={service.seoTitle}
  description={service.seoDescription}
  heading={service.name}
  eyebrow="Service"
  intro={service.summary}
  breadcrumbs={[{ name: 'Services', href: '/services' }, { name: service.name, href: `/services/${service.slug}` }]}
  schema={[serviceSchema(siteUrl, { name: service.name, description: service.description, url })]}
  pageType="MedicalWebPage"
>
  <section class="section pt-10" aria-labelledby="svc-overview">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <article class="lg:col-span-7">
        <IconTile name={service.icon} tone={service.tone} size="lg" />
        <h2 id="svc-overview" class="mt-6 text-3xl font-bold" data-split>About this service</h2>
        <div class="prose-clinic mt-5" data-reveal><p>{service.description}</p></div>
        {service.availabilityNote && <Notice class="mt-6">{service.availabilityNote}</Notice>}
        <h3 class="mt-10 text-xl font-bold" data-reveal>What’s included</h3>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2" data-stagger>
          {
            service.includes.map((i) => (
              <li class="flex items-start gap-3 rounded-2xl border border-line/70 bg-white p-4 shadow-soft">
                <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-teal-600" aria-hidden="true" />
                <span class="text-ink-soft">{i}</span>
              </li>
            ))
          }
        </ul>
      </article>
      <aside class="lg:col-span-5" aria-label="Enquire about this service">
        <div class="card sticky top-28 p-7 sm:p-8" data-reveal>
          <h2 class="text-2xl font-bold">Enquire about {service.name}</h2>
          <p class="mt-3 text-ink-soft">Contact the clinic to check availability or request an appointment. We’ll get back to you to confirm.</p>
          <div class="mt-7 flex flex-col gap-3">
            <Button href={`/contact?service=${service.slug}#enquiry`}>Request an appointment <ArrowRight className="size-4" aria-hidden="true" /></Button>
            {wa && <Button href={wa} variant="whatsapp" external><MessageCircle className="size-4" aria-hidden="true" /> Ask on WhatsApp</Button>}
            {telHref && <Button href={telHref} variant="secondary"><Phone className="size-4" aria-hidden="true" /> Call the clinic</Button>}
          </div>
          <p class="mt-6 text-xs leading-relaxed text-muted">For a life-threatening emergency, call <a href="tel:112" class="font-semibold text-ink underline">112</a> immediately.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="related-title">
    <div class="container-x">
      <h2 id="related-title" class="h-section" data-split>Other services</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {related.map((s) => <li><ServiceCard service={s} /></li>)}
      </ul>
      <a href="/services" class="mt-10 inline-flex items-center gap-2 font-semibold text-brand-700 hover:underline">See all services <ArrowRight className="size-4" aria-hidden="true" /></a>
    </div>
  </section>
  <CTABand />
</PageLayout>
